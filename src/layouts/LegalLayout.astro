---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} — achis.blog`} description={frontmatter.description}>
  <article class="legal">
    <slot />
  </article>
</BaseLayout>

<style>
  .legal :global(h1) {
    margin-top: 0;
  }

  .legal :global(h2) {
    line-height: 1.3;
    margin: 2rem 0 0.75rem;
  }

  .legal :global(p) {
    margin: 0 0 1rem;
  }

  .legal :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.4rem;
  }

  .legal :global(li) {
    margin: 0.35rem 0;
  }

  .legal :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .legal :global(code) {
    background: var(--bg-subtle);
    padding: 0.15em 0.4em;
    border-radius: 0.35em;
    font-size: 0.9em;
  }

  .legal :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--border);
  }

  .legal :global(a:hover) {
    text-decoration-color: currentColor;
  }
</style>
