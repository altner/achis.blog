---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
---

<nav class="nav">
  <a class="brand" href="/">achis.blog</a>
  <ul class="rubriken">
    {categories.map((category) => (
      <li>
        <a class="rubrik-link" href={`/${category.id}`} title={category.data.title} aria-label={category.data.title}>
          <Icon name={category.data.icon} />
        </a>
      </li>
    ))}
    <li>
      <a class="rubrik-link" href="/tags" title="Tags" aria-label="Tags">
        <Icon name="tags" />
      </a>
    </li>
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 36rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--fg);
    text-decoration: none;
  }

  .rubriken {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .rubrik-link {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: var(--fg-muted);
    text-decoration: none;
    transform-origin: center;
    transition: color 0.15s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .rubrik-link:hover,
  .rubrik-link:focus-visible {
    color: var(--accent);
    transform: scale(1.2);
  }

</style>
