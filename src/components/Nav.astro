---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const pathname = Astro.url.pathname;
---

<nav class="nav">
  <a class="brand" href="/" aria-current={pathname === '/' ? 'page' : undefined}>achis.blog</a>
  <ul class="categories">
    {categories.map((category) => {
      const isActive = pathname === `/${category.id}` || pathname.startsWith(`/${category.id}/`);

      return (
        <li>
          <a
            class="category-link"
            href={`/${category.id}`}
            aria-label={category.data.title}
            aria-current={isActive ? 'page' : undefined}
            data-label={category.data.title}
          >
            <Icon name={category.data.icon} />
          </a>
        </li>
      );
    })}
    <li>
      <a
        class="category-link"
        href="/tags"
        aria-label="Tags"
        aria-current={pathname === '/tags' || pathname.startsWith('/tags/') ? 'page' : undefined}
        data-label="Tags"
      >
        <Icon name="tags" />
      </a>
    </li>
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 36rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--fg);
    text-decoration: none;
  }

  .categories {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .category-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: var(--fg-muted);
    text-decoration: none;
    transform-origin: center;
    transition: color 0.15s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .category-link:hover,
  .category-link:focus-visible,
  .category-link[aria-current='page'] {
    color: var(--accent);
  }

  .category-link:hover,
  .category-link:focus-visible {
    transform: scale(1.2);
  }

  .category-link::before,
  .category-link::after {
    position: absolute;
    left: 50%;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -0.2rem);
    transition: opacity 0.12s ease, transform 0.12s ease;
  }

  .category-link::before {
    content: attr(data-label);
    top: calc(100% + 0.45rem);
    padding: 0.25rem 0.5rem;
    border-radius: 0.35rem;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  .category-link::after {
    content: '';
    top: calc(100% + 0.2rem);
    border-right: 0.3rem solid transparent;
    border-bottom: 0.3rem solid var(--fg);
    border-left: 0.3rem solid transparent;
  }

  .category-link:hover::before,
  .category-link:hover::after,
  .category-link:focus-visible::before,
  .category-link:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-link,
    .category-link::before,
    .category-link::after {
      transition: none;
    }
  }

</style>
