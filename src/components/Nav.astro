---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const categories = (await getCollection('tags')).sort((a, b) => a.data.order - b.data.order);
---

<nav class="nav">
  <a class="brand" href="/">achis.blog</a>
  <ul class="rubriken">
    {categories.map((category) => (
      <li class="rubrik">
        <a class="rubrik-link" href={`/tag/${category.id}`}>
          <Icon name={category.data.icon} />
          <span>{category.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--fg);
    text-decoration: none;
  }

  .rubriken {
    display: flex;
    justify-content: center;
    list-style: none;
    gap: 0;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .rubrik-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--fg-muted);
    font-size: 0.95rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
  }

  .rubrik-link:hover,
  .rubrik-link:focus-visible {
    color: var(--fg);
    background: var(--bg-subtle);
  }
</style>
