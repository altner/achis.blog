---
import { Icon as IconifyIcon } from 'astro-icon/components';

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const icons = {
  code: 'lucide:code',
  heart: 'lucide:heart',
  rocket: 'lucide:rocket',
  book: 'lucide:book-open',
  paw: 'lucide:paw-print',
  keyboard: 'lucide:keyboard',
  plane: 'lucide:plane',
  camera: 'lucide:camera',
  music: 'lucide:music',
  bike: 'lucide:bike',
  notebook: 'lucide:notebook-pen',
  backpack: 'lucide:backpack',
  compas: 'lucide:compass',
  footprints: 'lucide:footprints',
  tags: 'lucide:tags',
} as const;

const iconName = icons[name as keyof typeof icons];
---

{iconName && <IconifyIcon name={iconName} class={className} width={20} height={20} aria-hidden="true" />}
