---
import {
  Code,
  Heart,
  Rocket,
  BookOpen,
  PawPrint,
  Keyboard,
  Plane,
  Camera,
  Music,
  Bike,
  NotebookPen,
  Backpack,
  Compass,
  Footprints,
  Tags,
} from '@lucide/astro';

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const icons = {
  code: Code,
  heart: Heart,
  rocket: Rocket,
  book: BookOpen,
  paw: PawPrint,
  keyboard: Keyboard,
  plane: Plane,
  camera: Camera,
  music: Music,
  bike: Bike,
  notebook: NotebookPen,
  backpack: Backpack,
  compas: Compass,
  footprints: Footprints,
  tags: Tags,
} as const;

const IconComponent = icons[name as keyof typeof icons];
---

{IconComponent && <IconComponent class={className} size={20} stroke-width={2} aria-hidden="true" />}
