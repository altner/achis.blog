---
import { getCollection, getEntry, render } from 'astro:content';
import { posix } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RouteMap from '../../components/RouteMap.astro';
import Icon from '../../components/Icon.astro';

const POSTS_BASE = 'src/content/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { categorie: post.data.category?.id ?? 'misc', id: post.id },
    props: { id: post.id },
  }));
}

const { id } = Astro.props;
const post = await getEntry('posts', id);
if (!post) throw new Error(`Post not found: ${id}`);

const category = post.data.category ? await getEntry(post.data.category) : undefined;

// The .gpx file always lives next to its post — combine the post's own
// directory with the filename from frontmatter to get the activities id.
const activity =
  post.data.gpx && post.filePath
    ? await getEntry('activities', posix.join(posix.relative(POSTS_BASE, posix.dirname(post.filePath)), post.data.gpx))
    : undefined;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
---

<BaseLayout title={`${post.data.title} — achis.blog`} description={post.data.description}>
  <article>
    <p class="meta">
      {category && <a class="category-link" href={`/${category.id}`}>{category.data.title}</a>}
      <time datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
      {post.data.badges.length > 0 && (
        <span class="badges">
          {post.data.badges.map((badge) => (
            <Icon name={badge} class="badge-icon" />
          ))}
        </span>
      )}
    </p>
    <h1>{post.data.title}</h1>
    {activity && (
      <RouteMap
        points={activity.data.points}
        distanceKm={activity.data.distanceKm}
        elevationGainM={activity.data.elevationGainM}
      />
    )}
    <div class="content">
      <Content />
    </div>
    {post.data.tags.length > 0 && (
      <ul class="tags">
        {post.data.tags.map((tag) => (
          <li><a href={`/tags/${tag}`}>#{tag}</a></li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin-bottom: 0.5rem;
  }

  .badges {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .badges :global(.badge-icon) {
    width: 16px;
    height: 16px;
  }

  .category-link {
    background: var(--bg-subtle);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
  }

  h1 {
    margin-top: 0;
  }

  .content {
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .content :global(p) {
    margin: 1rem 0;
  }

  .content :global(h2),
  .content :global(h3) {
    line-height: 1.3;
    margin: 2.25rem 0 0.75rem;
  }

  .content :global(h2) {
    font-size: 1.4rem;
  }

  .content :global(h3) {
    font-size: 1.15rem;
  }

  .content :global(h2 + p),
  .content :global(h3 + p) {
    margin-top: 0;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 1rem 0;
    padding-left: 1.4rem;
  }

  .content :global(li) {
    margin: 0.35rem 0;
  }

  .content :global(li > p) {
    margin: 0;
  }

  .content :global(code) {
    background: var(--bg-subtle);
    padding: 0.15em 0.4em;
    border-radius: 0.35em;
    font-size: 0.9em;
  }

  .content :global(pre) {
    padding: 1rem;
    border-radius: 0.75rem;
    overflow-x: auto;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: 0.85em;
  }

  .content :global(blockquote) {
    margin: 1.25rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--border);
    color: var(--fg-muted);
    font-style: italic;
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .content :global(img) {
    max-width: 100%;
    border-radius: 0.75rem;
  }

  .content :global(a) {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(
      color-mix(in srgb, var(--marker) 65%, transparent),
      color-mix(in srgb, var(--marker) 65%, transparent)
    );
    background-repeat: no-repeat;
    background-size: 100% 35%;
    background-position: 0 88%;
    transition: background-size 0.15s ease;
  }

  .content :global(a:hover) {
    background-size: 100% 100%;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 2rem 0 0;
  }

  .tags a {
    font-size: 0.85rem;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .tags a:hover {
    color: var(--accent);
  }
</style>
