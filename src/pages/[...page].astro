---
import type { GetStaticPathsOptions, Page } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostTimestamp from '../components/PostTimestamp.astro';
import PostMetaCard from '../components/PostMetaCard.astro';
import DemoteH2 from '../components/headings/DemoteH2.astro';
import DemoteH3 from '../components/headings/DemoteH3.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection('posts'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return paginate(posts, { pageSize: 5 });
}

interface Props {
  page: Page<CollectionEntry<'posts'>>;
}

const { page } = Astro.props;

// Each post's own `##`/`###` headings are demoted one level here, since the
// teaser <h2> title above them already occupies that level — without this,
// every post's content headings would collide with the sibling post titles.
const headingOverrides = { h2: DemoteH2, h3: DemoteH3 };

const renderedPosts = await Promise.all(
  page.data.map(async (post) => ({ post, Content: (await render(post)).Content })),
);
---

<BaseLayout title="achis.blog" description="Notizen zu Code, Projekten und dem Leben dazwischen.">
  <h1 class="sr-only">Posts</h1>
  <ul class="post-list">
    {renderedPosts.map(({ post, Content }) => (
      <li class="post-item">
        <article>
          <PostTimestamp date={post.data.date} badges={post.data.badges} />
          <h2 class="post-title">
            <a href={`/${post.id}`}>{post.data.title}</a>
          </h2>
          <div class="content">
            <Content components={headingOverrides} />
          </div>
          <PostMetaCard date={post.data.date} tags={post.data.tags} />
        </article>
      </li>
    ))}
  </ul>

  <nav class="pager">
    {page.url.prev && <a class="pager-link" href={page.url.prev}>← Neuere Posts</a>}
    <span class="pager-status">Seite {page.currentPage} von {page.lastPage}</span>
    {page.url.next && <a class="pager-link" href={page.url.next}>Ältere Posts →</a>}
  </nav>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 1.5rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .post-item {
    border-bottom: 1px solid var(--border);
    padding-bottom: 3rem;
  }

  .post-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-title {
    margin: 0 0 1rem;
    font-size: 1.4rem;
  }

  .post-title a {
    text-decoration: none;
    color: inherit;
  }

  .post-title a:hover {
    color: var(--accent);
  }

  .content {
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .content :global(p) {
    margin: 1rem 0;
  }

  .content :global(h3),
  .content :global(h4) {
    line-height: 1.3;
    margin: 2.25rem 0 0.75rem;
  }

  .content :global(h3) {
    font-size: 1.15rem;
  }

  .content :global(h4) {
    font-size: 1rem;
  }

  .content :global(h3 + p),
  .content :global(h4 + p) {
    margin-top: 0;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 1rem 0;
    padding-left: 1.4rem;
  }

  .content :global(li) {
    margin: 0.35rem 0;
  }

  .content :global(li > p) {
    margin: 0;
  }

  .content :global(code) {
    background: var(--bg-subtle);
    padding: 0.15em 0.4em;
    border-radius: 0.35em;
    font-size: 0.9em;
  }

  .content :global(pre) {
    padding: 1rem;
    border-radius: 0.75rem;
    overflow-x: auto;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: 0.85em;
  }

  .content :global(blockquote) {
    margin: 1.25rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--border);
    color: var(--fg-muted);
    font-style: italic;
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .content :global(img) {
    max-width: 100%;
    border-radius: 0.75rem;
  }

  .content :global(a) {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(
      color-mix(in srgb, var(--marker) 65%, transparent),
      color-mix(in srgb, var(--marker) 65%, transparent)
    );
    background-repeat: no-repeat;
    background-size: 100% 35%;
    background-position: 0 88%;
    transition: background-size 0.15s ease;
  }

  .content :global(a:hover) {
    background-size: 100% 100%;
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .pager-link {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
  }

  .pager-link:hover {
    color: var(--accent);
  }

  .pager-status {
    color: var(--fg-muted);
  }
</style>
