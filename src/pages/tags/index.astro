---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).filter((post) => !post.data.draft);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags — achis.blog" description="Alle Tags auf achis.blog.">
  <h1>Tags</h1>
  <ul class="tag-list">
    {tags.map(([tag, count]) => (
      <li>
        <a href={`/tags/${tag}`}>
          <span class="tag-hash">#</span><span class="tag-name">{tag}</span>
          <span class="count">{count}</span>
        </a>
      </li>
    ))}
    {tags.length === 0 && <li class="empty">Noch keine Tags vorhanden.</li>}
  </ul>
</BaseLayout>

<style>
  .tag-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag-list a {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: var(--bg-subtle);
    border-radius: 999px;
    padding: 0.2rem 0.35rem 0.2rem 0.65rem;
    font-size: 0.85rem;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 600;
    background-image: linear-gradient(
      color-mix(in srgb, var(--accent) 10%, transparent),
      color-mix(in srgb, var(--accent) 10%, transparent)
    );
    background-repeat: no-repeat;
    background-size: 100% 0%;
    background-position: 0 88%;
    transition: background-size 0.15s ease;
  }

  .tag-list a:hover {
    background-size: 100% 100%;
  }

  .tag-hash {
    color: var(--fg);
    font-size: 0.9em;
    transition: color 0.15s ease;
  }

  .tag-list a:hover .tag-hash {
    color: color-mix(in srgb, var(--accent) 65%, transparent);
  }

  .tag-name {
    color: color-mix(in srgb, var(--accent) 65%, transparent);
  }

  .count {
    font-size: 0.75rem;
    color: var(--fg-muted);
    background: var(--bg-elevated);
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
